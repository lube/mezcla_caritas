<% if (game && game.background) { %>
<style>
  body {
    position: relative;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: url('/<%= game.background.split('/').slice(-2).join('/') %>') right center/contain no-repeat;
    opacity: 0.15;
    filter: brightness(1.2);
    pointer-events: none;
    z-index: -1;
  }
  body::after {
    content: '<%= ((game.backgroundOwner ? game.backgroundOwner + " - " : "") + (game.backgroundTitle || "Nico siendo perseguido por una viejita en Manhattan")).replace(/'/g, "\\'") %>';
    position: fixed;
    bottom: 0.5rem;
    right: 0;
    left: auto;
    width: 40vw;
    text-align: center;
    font-size: 1.25rem;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    z-index: -1;
  }
</style>
<% } %>

